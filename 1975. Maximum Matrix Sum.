class Solution {
    public long maxMatrixSum(int[][] arr) {
        int count = 0,minElement = Integer.MAX_VALUE;
        long sum = 0;
        for(int i = 0;i < arr.length;i++) {
            int negative = 0;
            for(int j = 0;j < arr[i].length;j++) {
                if(arr[i][j] < 0) {
                    negative++;
                }
                sum += Math.abs(arr[i][j]);
                minElement = Math.min(minElement,Math.abs(arr[i][j]));
            }
            if(negative % 2 != 0) {count++;}
        }
        if(count % 2 == 0) {
            return sum;
        }
        return sum - (minElement * 2);
    }
}
